# Без этих переменных приложение работает в демо-режиме: данные в браузере (localStorage).
# С ними — Supabase: схема zakupka, вход демо-аккаунтами, живые уведомления между устройствами.
# Ключ — публичный (publishable / anon), он и так уходит в браузер. service_role сюда не класть.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
